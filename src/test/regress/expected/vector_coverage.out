(6 rows)

EXPLAIN (COSTS OFF) SELECT d, count(*) FROM cov_aoco GROUP BY d ORDER BY d LIMIT 5;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Limit
   ->  Gather Motion 3:1  (slice1; segments: 3)
         Merge Key: vector_region_1.c1
         ->  Limit
               ->  Sort
                     Sort Key: vector_region_1.c1
                     ->  Custom Scan (VectorRegion)
                           ->  Finalize HashAggregate
                                 Group Key: vector_region.c1
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: vector_region.c1
                                       ->  Custom Scan (VectorRegion)
                                             ->  Partial HashAggregate
                                                   Group Key: cov_aoco.d
                                                   ->  Seq Scan on cov_aoco
(16 rows)

EXPLAIN (COSTS OFF) SELECT DISTINCT a FROM cov_aoco;
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (VectorRegion)
         ->  HashAggregate
               Group Key: cov_aoco.a
               ->  Seq Scan on cov_aoco
(6 rows)

EXPLAIN (COSTS OFF) SELECT d, GROUPING(d) FROM cov_aoco GROUP BY ROLLUP (d);
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (VectorRegion)
         ->  Finalize HashAggregate
               Group Key: vector_region.c1, vector_region.c3
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: vector_region.c1, vector_region.c3
                     ->  Custom Scan (VectorRegion)
                           ->  Partial MixedAggregate
                                 Hash Key: cov_aoco.d
                                 Group Key: ()
                                 ->  Seq Scan on cov_aoco
(12 rows)

-- joins
EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco p JOIN cov_aoco q ON p.a = q.a;
                         QUERY PLAN                         
------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Hash Join
                           Hash Cond: (p.a = q.a)
                           ->  Seq Scan on cov_aoco p
                           ->  Hash
                                 ->  Seq Scan on cov_aoco q
(10 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco p JOIN cov_aoco q ON p.d = q.d;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Hash Join
                           Hash Cond: (vector_region.c1 = vector_region_1.c1)
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: vector_region.c1
                                 ->  Custom Scan (VectorRegion)
                                       ->  Seq Scan on cov_aoco p
                           ->  Hash
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: vector_region_1.c1
                                       ->  Custom Scan (VectorRegion)
                                             ->  Seq Scan on cov_aoco q
(16 rows)

SET enable_hashjoin = off;
EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco p JOIN cov_aoco q ON p.a = q.a;
                            QUERY PLAN                            
------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Custom Scan (VectorRegion)
                     ->  Merge Join
                           Merge Cond: (p.a = vector_region.c1)
                           ->  Sort
                                 Sort Key: p.a
                                 ->  Seq Scan on cov_aoco p
                           ->  Custom Scan (VectorRegion)
                                 ->  Sort
                                       Sort Key: q.a
                                       ->  Seq Scan on cov_aoco q
(14 rows)

RESET enable_hashjoin;
EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco p JOIN cov_heap q ON p.d = q.d;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Hash Join
                           Hash Cond: (vector_region.c1 = vector_region_1.c1)
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: vector_region.c1
                                 ->  Custom Scan (VectorRegion)
                                       ->  Seq Scan on cov_aoco p
                           ->  Hash
                                 ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                       Hash Key: vector_region_1.c1
                                       ->  Custom Scan (VectorRegion)
                                             ->  Seq Scan on cov_heap q
(16 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco WHERE EXISTS (SELECT 1 FROM cov_heap WHERE cov_heap.a = cov_aoco.a);
                           QUERY PLAN                           
----------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Hash Semi Join
                           Hash Cond: (cov_aoco.a = cov_heap.a)
                           ->  Seq Scan on cov_aoco
                           ->  Hash
                                 ->  Seq Scan on cov_heap
(10 rows)

-- heap leaf through the row adapter, append over union all
EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_heap WHERE d = 'h3';
                     QUERY PLAN                     
----------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Seq Scan on cov_heap
                           Filter: (d = 'h3'::text)
(7 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_heap WHERE a IN (1, 2);
                         QUERY PLAN                         
------------------------------------------------------------
 Aggregate
   ->  Gather Motion 2:1  (slice1; segments: 2)
         ->  Custom Scan (VectorRegion)
               ->  Seq Scan on cov_heap
                     Filter: (a = ANY ('{1,2}'::integer[]))
(6 rows)

EXPLAIN (COSTS OFF) SELECT count(*) FROM
  (SELECT a, d FROM cov_heap UNION ALL SELECT a, e FROM cov_aoco) t;
                        QUERY PLAN                        
----------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Append
                     ->  Custom Scan (VectorRegion)
                           ->  Seq Scan on cov_heap
                     ->  Subquery Scan on "*SELECT* 2"
                           ->  Custom Scan (VectorRegion)
                                 ->  Seq Scan on cov_aoco
(10 rows)

EXPLAIN (COSTS OFF) SELECT a, count(*) FROM
  (SELECT a, d FROM cov_heap UNION ALL SELECT a, d FROM cov_heap) t
GROUP BY a;
                          QUERY PLAN                           
---------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (VectorRegion)
         ->  HashAggregate
               Group Key: vector_region.c1
               ->  Custom Scan (VectorRegion)
                     ->  Append
                           ->  Seq Scan on cov_heap
                           ->  Seq Scan on cov_heap cov_heap_1
(9 rows)

-- uncorrelated initplan/subplan
EXPLAIN (COSTS OFF) SELECT count(*) FROM cov_aoco WHERE a = (SELECT max(a) FROM cov_heap);
                       QUERY PLAN                       
--------------------------------------------------------
 Aggregate
   InitPlan 1 (returns $0)  (slice2)
     ->  Finalize Aggregate
           ->  Gather Motion 3:1  (slice3; segments: 3)
                 ->  Custom Scan (VectorRegion)
                       ->  Partial Aggregate
                             ->  Seq Scan on cov_heap
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Seq Scan on cov_aoco
                     Filter: (a = $0)
(12 rows)

RESET gp_vectorized_execution;
DROP TABLE cov_aoco;
DROP TABLE cov_heap;
