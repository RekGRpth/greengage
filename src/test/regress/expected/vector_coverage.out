-- aggregates, plain and grouped
EXPLAIN (COSTS OFF) SELECT count(*), sum(a), avg(c), min(g), max(h) FROM cov_aoco;
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (VectorRegion)
               ->  Partial Aggregate
                     ->  Seq Scan on cov_aoco
