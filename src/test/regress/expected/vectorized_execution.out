-- With an empty targetlist the divergent mapping is unavailable, so the
-- Append stays on the row executor above independent per-child regions.
EXPLAIN (COSTS OFF)
SELECT count(*) FROM
(SELECT id, v FROM vector_union_a UNION ALL SELECT id, v FROM vector_union_b) t
WHERE t.id < 100 AND (SELECT count(*) FROM vector_aoco_small s WHERE s.id = t.id) > 0;
                                              QUERY PLAN                                               
-------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Append
                     ->  Custom Scan (VectorRegion)
                           ->  Seq Scan on vector_union_a
                                 Filter: ((id < 100) AND ((SubPlan 1 (copy 2)) > 0))
                                 SubPlan 1 (copy 2)
                                   ->  Aggregate
                                         ->  Result
                                               Filter: (vector_region_2.c1 = vector_union_a.id)
                                               ->  Materialize
                                                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                                           ->  Custom Scan (VectorRegion)
                                                                 ->  Seq Scan on vector_aoco_small s
                     ->  Custom Scan (VectorRegion)
                           ->  Seq Scan on vector_union_b
                                 Filter: ((id < 100) AND ((SubPlan 1 (copy 3)) > 0))
                                 SubPlan 1 (copy 3)
                                   ->  Aggregate
                                         ->  Result
                                               Filter: (vector_region_3.c1 = vector_union_b.id)
                                               ->  Materialize
                                                     ->  Broadcast Motion 3:3  (slice3; segments: 3)
                                                           ->  Custom Scan (VectorRegion)
                                                                 ->  Seq Scan on vector_aoco_small s_1
(27 rows)

SELECT count(*) FROM
(SELECT id, v FROM vector_union_a UNION ALL SELECT id, v FROM vector_union_b) t
WHERE t.id < 100 AND (SELECT count(*) FROM vector_aoco_small s WHERE s.id = t.id) > 0;
 count 
-------
    10
(1 row)

-- EXPLAIN resolves motion keys through custom_ps and the Agg display chain.
EXPLAIN (COSTS OFF)
SELECT l.id, sum(r.id) FROM vector_join_l l JOIN vector_join_r r ON l.id = r.id
GROUP BY l.id ORDER BY l.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: vector_region.id
   ->  Custom Scan (VectorRegion)
         ->  GroupAggregate
               Group Key: l.id
               ->  Sort
                     Sort Key: l.id
                     ->  Hash Join
                           Hash Cond: (l.id = r.id)
                           ->  Seq Scan on vector_join_l l
                           ->  Hash
                                 ->  Seq Scan on vector_join_r r
(13 rows)

SELECT l.id, sum(r.id) FROM vector_join_l l JOIN vector_join_r r ON l.id = r.id
GROUP BY l.id ORDER BY l.id;
