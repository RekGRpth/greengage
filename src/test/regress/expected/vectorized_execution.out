(1 row)

-- RIGHT join over a join chain (the aggregate sits between the join and
-- the region root): probe rows with no build match are dropped, and the
-- finish phase emits unmatched build rows null-extended across output
-- batch boundaries.
EXPLAIN (COSTS OFF)
SELECT cnt, count(*) AS custdist FROM
  (SELECT l.id AS lk, count(w.id) AS cnt
   FROM vector_aoco_wide w RIGHT JOIN vector_aoco_test l
     ON w.id % 2000 = l.id
   GROUP BY l.id) s
GROUP BY cnt ORDER BY custdist DESC, cnt DESC;
                                                     QUERY PLAN                                                      
---------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: vector_region_4.c2, vector_region_4.c1
   ->  Sort
         Sort Key: vector_region_4.c2 DESC, vector_region_4.c1 DESC
         ->  Custom Scan (VectorRegion)
               ->  Finalize HashAggregate
                     Group Key: vector_region_3.c1
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: vector_region_3.c1
                           ->  Custom Scan (VectorRegion)
                                 ->  Partial HashAggregate
                                       Group Key: (count(vector_region_2.in2))
                                       ->  Custom Scan (VectorRegion)
                                             ->  HashAggregate
                                                   Group Key: vector_region_1.c1
                                                   ->  Hash Right Join
                                                         Hash Cond: ((vector_region.c1 % 2000) = vector_region_1.c1)
                                                         ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                                               Hash Key: (vector_region.c1 % 2000)
                                                               ->  Custom Scan (VectorRegion)
                                                                     ->  Seq Scan on vector_aoco_wide w
                                                         ->  Hash
                                                               ->  Custom Scan (VectorRegion)
                                                                     ->  Seq Scan on vector_aoco_test l
(25 rows)

SELECT cnt, count(*) AS custdist FROM
  (SELECT l.id AS lk, count(w.id) AS cnt
   FROM vector_aoco_wide w RIGHT JOIN vector_aoco_test l
     ON w.id % 2000 = l.id
   GROUP BY l.id) s
GROUP BY cnt ORDER BY custdist DESC, cnt DESC;
 cnt | custdist 
-----+----------
   0 |     2737
   3 |      910
   2 |      908
