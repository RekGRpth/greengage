SET enable_hashjoin = off;
SET enable_nestloop = off;
SET enable_mergejoin = on;
SET optimizer_enable_hashjoin = off;
SET optimizer_enable_nljoin = off;
EXPLAIN (COSTS OFF)
SELECT l.id, l.l, r.id, r.r
FROM vector_join_l l JOIN vector_join_r r ON l.id = r.id
ORDER BY l.id, r.r;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: vector_region_1.c1, vector_region_1.c4
   ->  Sort
         Sort Key: vector_region_1.c1, vector_region_1.c4
         ->  Custom Scan (VectorRegion)
               ->  Merge Join
                     Merge Cond: (l.id = vector_region.c1)
                     ->  Sort
                           Sort Key: l.id
                           ->  Seq Scan on vector_join_l l
                     ->  Custom Scan (VectorRegion)
                           ->  Sort
                                 Sort Key: r.id
                                 ->  Seq Scan on vector_join_r r
(15 rows)

